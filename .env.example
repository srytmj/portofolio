# Homelab launcher (the Ctrl+K palette in owner mode) — one URL per service.
# Copy this file to `.env` and fill each value with the service's Tailscale
# subdomain, e.g.  PUBLIC_JELLYFIN_URL=http://jellyfin.<your-tailnet>.ts.net
#
# These are PUBLIC_ vars: they get baked into the built JS at build time
# (`$env/static/public`). Run `npm run build` again after changing them.
# That's fine — the URLs only resolve inside your tailnet.
# A blank value = a greyed-out "no url set" row in the palette.

# Projects
PUBLIC_MALAS_URL=
PUBLIC_WHITEARCHIVE_URL=
PUBLIC_SSO_WHITEARCHIVE_URL=
PUBLIC_BLOG_URL=
PUBLIC_PORE_JS_URL=

# Media
PUBLIC_JELLYFIN_URL=
PUBLIC_IMMICH_URL=
PUBLIC_NEXTCLOUD_URL=
PUBLIC_KAVITA_URL=

# Tools
PUBLIC_N8N_URL=
PUBLIC_ALEXANDRIE_URL=
PUBLIC_VAULTWARDEN_URL=
PUBLIC_FIREFLY_III_URL=
PUBLIC_SHIORI_URL=
PUBLIC_YOURLS_URL=
PUBLIC_RECLIP_URL=

# Infra / Monitoring
PUBLIC_UPTIME_KUMA_URL=
PUBLIC_NETDATA_URL=
PUBLIC_HOMELABLE_URL=
PUBLIC_PORTAINER_URL=
